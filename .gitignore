# --- FastEddy model source: separate repository (fork of NCAR/FastEddy-model) ---
# Pinned by FASTEDDY_VERSION.txt. Never vendored into this repo.
FastEddy-model-5.0.1/

# --- Large binary input data: never committed. Provenance in data/README.md ---
*.zip
*.tar.gz
*.tif
*.tif.ovr
data/raw/
data/grid/
data/grid_cbl/
data/conus404/
data/hrrr/
results/soundings/
results/forcing/
pairs/

# --- LES output: regenerable, and far too large. Peak storage is one run. ---
# The dumps are named FE_<TAG>.<step>, so they have NO extension a pattern can catch --
# `*.nc` does not match `FE_WIN.49680`. Every directory that can hold them is listed by
# name. Getting this wrong put 22 GB of fields into git history on 2026-08-20.
runs/**/output/
runs/**/window/
runs/**/FE_RST.*
# Catch-all: any FastEddy dump anywhere, whatever directory it lands in.
FE_*.[0-9]
FE_*.[0-9][0-9]*
runs/**/output_binary/
runs/**/initial/
runs/**/ICBC/
*.nc
!scripts/**/*.json

# --- Build artifacts (FastEddy builds in-tree; belt and braces) ---
*.o
FastEddy
FastEddy_devlink.o

# --- Python ---
__pycache__/
*.pyc
.ipynb_checkpoints/

# --- Editors / OS ---
.DS_Store
*.swp

# --- Local CodeGraph index ---
.codegraph/

# --- Stage 6 preprocessing products: regenerable from the DEM ---
*.bin
*.npy
data/case_grids/
data/smokelib/
results/corpus/
results/pick/

# --- generated per-case run directories: the corpus makes ~1825 of them ---
# The .in files under runs/ are tracked for the retired passes, which are the record.
# A corpus case's directory is regenerable from its sounding and is not.
runs/case_*/
runs/yr_*/
runs/e2e_*/
runs/c2_check/
runs/c2_roundtrip/
runs/g16_b6cbl/

# Seed-job scratch: the segment .in files the driver writes, and smoke-test copies.
# A job bundle is seed.in + manifest.json + run_seed.sh and nothing else.
jobs/*/smoke.in
jobs/*/seg*.in
# run.in is generated per invocation by jobs/run_seed.sh (Nt, inPath/inFile and
# surflayer_wth substituted into seed.in); seed.in is the tracked source of truth.
jobs/*/run.in
jobs/*/return/

# retired stable seed jobs -- kept on disk as evidence, archived under results/
jobs/seed_sbl_*/
jobs/seed_sbl-weak_*/
runs/dryrun_test/
runs/skiptest/
runs/unchain_test/

# the generated corpus: ~100 MB of .npz plus corpus.h5. Data, not source.
# The safety copy is ~/Desktop/corpus; the record of what produced it is the image tag
# in corpus/README.md.
corpus/

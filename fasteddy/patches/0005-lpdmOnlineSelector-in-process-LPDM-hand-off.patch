+        sigma_w floor is built from whole-window statistics, so the last snapshot must be
+        in the ring before any release fires. A pause is not a restart -- no exit, no
+        re-read, no IO-registered field overwritten -- so FASTEDDY_TRAPS.md 17 does not
+        apply to it. */
+     if(lpdmOnlineSelector > 0){
+       lpdmOnlinePause(it);
+     }
      //Dump tower data if appropriate
      if((towerIOSelector > 0) && (it > simTime_itRestart)){
        ioWriteBinaryTowerFileSingleBatch(it, NtBatch, Nz, simTimeBatch, towersData, towersSurfData, 
@@ -573,6 +596,12 @@ int main(int argc, char **argv){
   }
 #endif
   MPI_Barrier(MPI_COMM_WORLD); 
+  /* The final dump has been staged; release the last window and tell the consumer the run
+     is over, so it stops polling instead of timing out. */
+  if(lpdmOnlineSelector > 0){
+    lpdmOnlinePause(it);
+    lpdmOnlineFinish();
+  }
   //Dump tower data if appropriate
   if(towerIOSelector > 0){
     ioWriteBinaryTowerFileSingleBatch(it, NtBatch, Nz, simTimeBatch, towersData, towersSurfData, towerIDs, rank_nTowers, towerInstanceSize, towerSurfInstanceSize);

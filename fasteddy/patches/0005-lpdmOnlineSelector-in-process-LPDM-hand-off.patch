+   lpdmOnlineSelector=0;
+   errorCode = queryIntegerParameter("lpdmOnlineSelector", &lpdmOnlineSelector, 0, 2, PARAM_OPTIONAL);
+   lpdmOnlineQueue=4;
+   errorCode = queryIntegerParameter("lpdmOnlineQueue", &lpdmOnlineQueue, 1, 64, PARAM_OPTIONAL);
+   lpdmOnlinePause1=0;
+   errorCode = queryIntegerParameter("lpdmOnlinePause1", &lpdmOnlinePause1, 0, INT_MAX, PARAM_OPTIONAL);
+   lpdmOnlinePause2=0;
+   errorCode = queryIntegerParameter("lpdmOnlinePause2", &lpdmOnlinePause2, 0, INT_MAX, PARAM_OPTIONAL);

+  MPI_Barrier(MPI_COMM_WORLD);
 #ifdef DEBUG_INITIALIZATION 
   printf("mpi_rank_world--%d/%d Dumping parameter check results!\n",mpi_rank_world, mpi_size_world);
   fflush(stdout);
@@ -462,6 +476,15 @@ int main(int argc, char **argv){
          fflush(stdout);
        } //if mpi_rank_world
      } //end if (it%frqOutput == 0) ....   (We log summary info and dump outputs)
+     /* Hand a completed window to the LPDM and block until it has integrated. Placed

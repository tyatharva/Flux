--- a/SRC/FEMAIN/FastEddy.c
+++ b/SRC/FEMAIN/FastEddy.c
@@ -163,6 +163,20 @@ int main(int argc, char **argv){
 #endif
   errorCode = timeInit();
   MPI_Barrier(MPI_COMM_WORLD); 
+  /* IN-PROCESS LPDM HAND-OFF (fork). Allocates staging and publishes the snapshot format
+     to lpdmOnlineDir. A no-op unless lpdmOnlineSelector > 0, so every unmodified .in --
+     including every tutorial case -- reaches this line and passes straight through. It
+     goes AFTER timeInit because it needs the settled dt, and after the grid because it
